	"Depots"
	{
		// NOTE: verify the depot ID in Steamworks > SteamPipe > Depots.
		// Valve auto-creates AppID+1 (4866691) as the first depot by convention.
		"4866691" "depot_build_4866691.vdf"
	}
}
